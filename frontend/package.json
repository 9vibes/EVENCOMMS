{
  "name": "evencomms",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "node --test src/operator/*.test.mjs src/glasses/*.test.mjs",
    "test:e2e": "playwright test",
    "pack": "npm run build && node scripts/pack.mjs",
    "simulate": "evenhub-simulator http://localhost:5173/glasses.html"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16",
    "hls.js": "1.7.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@evenrealities/evenhub-cli": "0.1.14",
    "@evenrealities/evenhub-simulator": "0.9.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "vite": "8.3.1"
  }
}
