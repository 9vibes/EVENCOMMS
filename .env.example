# Required: set a long, unique password before starting. Never commit .env.
ADMIN_PASSWORD=

# Standalone host port is 28097. Prefer a LAN IP over 0.0.0.0 for LAN testing.
BIND_ADDRESS=127.0.0.1
# Separate RTMP listener. Set to the host's LAN/VPN IP for a remote encoder.
# 21936 avoids SteamLab's 21935, but check the actual host for port conflicts.
RTMP_BIND=127.0.0.1
RTMP_PORT=21936
# Required for a remote encoder: its reachable LAN/VPN hostname or IP only.
# No scheme, port or path. localhost works only for an encoder on this host.
PUBLIC_HOST=localhost
STREAM_ENABLED=true
# Set true when browser access is through HTTPS; false is for isolated HTTP.
COOKIE_SECURE=false
# MEDIA_API_URL and MEDIA_HLS_URL are fixed private service origins in Compose.

# Comma-separated exact HTTP(S) origins, not URLs with paths or wildcards.
# With TLS termination, include the public HTTPS origin even for same-origin UI.
# Also include the actual packaged Even app origin for cross-origin API access.
# ALLOWED_ORIGINS=https://comms.example.net,https://actual-app-origin.example
ALLOWED_ORIGINS=
# Opt in only for installed Even clients observed at http://127.0.0.1:<port>.
# Allows any valid port at that exact host for CORS and wearer WebSockets.
ALLOW_EVEN_LOCALHOST=false

# CPU/int8, English short-utterance transcription; first use downloads the model.
STT_ENABLED=true
STT_MODEL=base.en
STT_TIMEOUT=90

# Existing local Ollama only. Empty URL or model disables AI suggestions.
# Host Ollama must listen on an interface reachable from Docker, not just loopback.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=30

# Optional shared server-side key for RESEARCH, never a VITE_ variable.
# Alternatively connect a key for the current sign-in from the HTTPS Research UI.
# Research sends selected text/images to OpenAI only on explicit Send (billable).
OPENAI_API_KEY=
OPENAI_TIMEOUT=90
OPENAI_MAX_OUTPUT_TOKENS=2048

# Experimental Codex: standalone opts in only with compose.codex.yml.
# Generate a private 64-character hex service secret (openssl rand -hex 32).
# This is NOT an OpenAI credential. Never use the app/operator password.
# Leave blank for ordinary standalone deployment; never print expanded Compose.
# Umbrel provisions codex-auth/token automatically and mounts it read-only into
# backend + bridge as CODEX_BRIDGE_TOKEN_FILE=/run/codex-auth/token instead.
# TOKEN and TOKEN_FILE are mutually exclusive; no manual Umbrel token setup.
# Account use still requires Research provider choice, device login, model + Send.
# Prefer HTTPS. HTTP device-code login requires trusted-network confirmation;
# API-key entry remains HTTPS/loopback-only. See docs/codex.md for privacy limits.
CODEX_BRIDGE_TOKEN=

MAX_SESSIONS=100
MAX_MESSAGES_PER_SESSION=1000
